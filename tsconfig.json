{
  // This file is not used in compilation. It is here just for a nice editor experience.
  //
  // Inlined from @docusaurus/tsconfig rather than extending it: that config still sets
  // "baseUrl", which TypeScript 7 removed, and an inherited option can't be unset.
  // Keep in sync with https://github.com/facebook/docusaurus/blob/main/packages/docusaurus-tsconfig/tsconfig.json
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
